# Copy to .env (or export) to use the real LLM. Without a key the assistant
# falls back to the deterministic offline backend (no network needed).
ANTHROPIC_API_KEY=
LLM_BACKEND=auto            # auto | anthropic | offline
ANTHROPIC_MODEL=claude-haiku-5-5
# USD per 1M tokens -- verify against current pricing before trusting cost numbers
PRICE_INPUT_PER_MTOK=1.0
PRICE_OUTPUT_PER_MTOK=5.0
